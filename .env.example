# Copia in .env.local (mai nel repository) e compila quello che serve.

# Chiave RAWG (https://rawg.io/apidocs), facoltativa: con la chiave la
# ricerca giochi del mondo Nerd (Gaming PC / PS / Xbox) interroga anche il
# catalogo RAWG con copertine, anno, piattaforme e generi. Senza chiave la
# ricerca funziona lo stesso, solo sul catalogo condiviso.
VITE_RAWG_KEY=

# Server TURN per le videochiamate (facoltativi, vedi src/data/calls.js).
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
